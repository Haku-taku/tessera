# Strings owned by ui-widgets: shortcut labels and list counts.
# 归 ui-widgets 所有的文案：快捷键标签与列表计数。

## Shortcuts
## 快捷键

widgets-shortcut-ctrl = Ctrl
widgets-shortcut-alt = Alt
widgets-shortcut-shift = Shift
widgets-shortcut-super = Super
# Separator between held modifiers and the key; spaces belong to the translation.
# 修饰键与键之间的分隔符；空格属于译文。
widgets-shortcut-separator = { " + " }
widgets-shortcut-escape = Esc
widgets-shortcut-enter = 回车
widgets-shortcut-space = 空格
widgets-shortcut-tab = Tab
widgets-shortcut-backspace = 退格
widgets-shortcut-delete = 删除
widgets-shortcut-insert = 插入
widgets-shortcut-home = 行首
widgets-shortcut-end = 行尾
widgets-shortcut-page-up = 上一页
widgets-shortcut-page-down = 下一页
widgets-shortcut-left = 左
widgets-shortcut-right = 右
widgets-shortcut-up = 上
widgets-shortcut-down = 下

## Lists
## 列表

# Chinese has one CLDR plural category, so no variant key is needed.
# 中文只有一个 CLDR 复数类别，因此不需要变体 key。
widgets-list-selected-count = 已选择 { $count } 个项目

## Code cards
## 代码卡片

# 没有 info string 的围栏在卡片头部也有名字。
widgets-code-plain-text = 纯文本
# 中文只有一个 CLDR 复数类别，因此不需要变体 key。
widgets-code-line-count = { $count } 行

## Menus
## 菜单

# 引擎内建的文本行；应用通过 `set_text_menu_labels` 为它们命名。
widgets-menu-select-all = 全选
widgets-menu-copy = 复制
widgets-menu-cut = 剪切
widgets-menu-paste = 粘贴
